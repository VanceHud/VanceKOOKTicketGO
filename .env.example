# KOOK Ticket 环境变量示例
#
# 用法：cp .env.example .env 后按需修改，docker compose 会自动读取。
# 注意：.env 已被 .gitignore 忽略，不要把真实密钥提交到仓库。

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
# WebUI 监听端口（容器内固定 8080，这里指的是宿主机映射端口）
PORT=8080

# 数据目录（容器内固定 /app/data，对应宿主机的 ./data 卷）
DATA_DIR=/app/data

# 业务时区：决定工单编号中的日期段与仪表盘“今日”口径
TICKET_TZ=Asia/Shanghai

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# KOOK 接入
# ---------------------------------------------------------------------------
# 1 = 离线演示模式：不连接 KOOK，写入演示工单，仅用于本地验收界面
KOOK_DRYRUN=0

# 机器人 Token（开发者后台 → 机器人 → 令牌）。
# 也可以留空，启动后在 WebUI「系统设置」里填写；两种方式都会以 AES-GCM 加密入库。
KOOK_TOKEN=

# 机器人服务的服务器 ID（可留空，稍后在 WebUI 中填写）
KOOK_GUILD_ID=

# ---------------------------------------------------------------------------
# 安全
# ---------------------------------------------------------------------------
# 加密密钥：用于加密存储 KOOK Token（也用于派生 CSRF 令牌）。
# 生成建议：openssl rand -hex 32
# 留空时会在数据目录自动生成 app_secret（权限 0600）并复用；
# 一旦更换该值，已存储的 Token 将无法解密，需要在 WebUI 重新填写。
APP_SECRET=

# 会话 Cookie 的 Secure 策略：auto（按请求是否 HTTPS 自动判断）/ always / never
COOKIE_SECURE=auto

# 可信反向代理地址（逗号分隔，支持 CIDR）。
# 只有来自这些地址的 X-Forwarded-For / X-Forwarded-Proto 才会被采信；
# 未配置时一律使用直连地址，避免伪造头绕过限流与审计。
# 例：172.18.0.0/16,127.0.0.1
TRUSTED_PROXIES=

# 初始管理员账号：仅在数据库中还没有任何账号时生效。
# ADMIN_PASSWORD 留空时会生成随机密码，并在启动日志中打印一次（首登强制改密）。
# 若显式设置，则必须满足强度要求（≥12 位且包含两类以上字符），否则启动失败。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 会话与登录保护
# ---------------------------------------------------------------------------
# 会话空闲过期（小时）与绝对有效期（天）
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# 登录失败限流：窗口内失败次数上限、统计窗口（分钟）、锁定时长（分钟）
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
